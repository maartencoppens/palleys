# Bancontact Pro (contract via KBC). API-sleutel en payment profile ID uit portal.bancontactpro.com.
# BANCONTACT_ENV=preprod om te testen, production voor echte betalingen. APP_URL moet https zijn (return-URL).
BANCONTACT_API_KEY=
BANCONTACT_PAYMENT_PROFILE_ID=
BANCONTACT_ENV=preprod

# Alleen lokaal: PAYMENT_PROVIDER=fake geeft nepbetalingen om de hele flow te testen zonder Bancontact. Staat in productie altijd uit.
PAYMENT_PROVIDER=

# Resend (bevestigingsmails). Leeg = geen mails (de backoffice kan ze later opnieuw sturen).
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=

# Bearer-secret voor POST /api/cron/expire-orders (minstens 32 tekens, bv. `openssl rand -hex 32`).
CRON_SECRET=
