# Stripe (gehoste Checkout, enkel Bancontact en iDEAL | Wero via een payment method configuration).
# Test- en live-modus hebben elk hun eigen sleutels én hun eigen pmc_-configuratie. Leeg = betalen niet beschikbaar.
# STRIPE_SECRET: secret key (sk_test_… / sk_live_…) of restricted key (rk_…), uit Developers → API keys.
STRIPE_SECRET=
# STRIPE_PUBLIC: publishable key (pk_…). Momenteel niet gebruikt (de gehoste Checkout heeft hem niet nodig).
STRIPE_PUBLIC=
# STRIPE_WEBHOOK_SECRET: whsec_…; lokaal van `stripe listen --forward-to localhost:3000/api/webhooks/stripe`,
# in productie van het webhook-endpoint in het dashboard.
STRIPE_WEBHOOK_SECRET=
# STRIPE_PAYMENT_METHOD_CONFIG: pmc_… (Settings → Payment methods); verschilt tussen test- en live-modus.
STRIPE_PAYMENT_METHOD_CONFIG=

# Alleen lokaal: PAYMENT_PROVIDER=fake geeft nepbetalingen om de hele flow te testen zonder Stripe. Staat in productie altijd uit.
PAYMENT_PROVIDER=

# Resend (bevestigingsmails). Leeg = geen mails (de backoffice kan ze later opnieuw sturen).
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=

# Bearer-secret voor POST /api/cron/expire-orders (minstens 32 tekens, bv. `openssl rand -hex 32`).
CRON_SECRET=
