// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

enum PreviewStatus {
  UPLOADED
  PAID
  GENERATING_POSE
  POSE_READY
  GENERATING_MODEL
  MODEL_READY
  APPROVED
  PRINT_READY
  FAILED
  EXPIRED
}

model Preview {
  id              String                @id @default(uuid())
  status          PreviewStatus         @default(UPLOADED)
  poseImageKey    String?
  glbKey          String? // voor de 3D-viewer in de backoffice
  objKey          String? // printbestanden voor full color resin:
  mtlKey          String? //   OBJ + MTL + PNG-textuur, altijd samen
  textureKey      String?
  meshyTaskId     String?               @unique
  email           String?
  poseAttempts    Int                   @default(0)
  error           String?
  paidAt          DateTime? // orderdatum, gezet bij betaling (Stripe-webhook of statuscheck)
  animalType      String? // code uit src/data/animals.ts, gekozen door de admin
  quantity        Int                   @default(1) // aantal exemplaren van deze Palley in de order, gezet bij betaling
  createdAt       DateTime              @default(now())
  expiresAt       DateTime? // alleen voor niet-betaalde uploads, leeg na betaling
  photosDeleteAt  DateTime? // niet meer gebruikt: zie photosDeletedAt en core/modules/retention
  // Bewaartermijnen uit het privacybeleid (core/modules/retention): wanneer de cron de foto's, de pose en de tussenmodellen
  // verwijderde, en wanneer het printklare model.
  photosDeletedAt DateTime?
  modelDeletedAt  DateTime?
  downloadedAt    DateTime?
  downloadedBy    String?
  processedKey    String? // zip uit Blender, klaar voor print
  processedAt     DateTime?
  processedBy     String?
  // Gemaakt om een collectible van te maken (backoffice-order), niet voor een klant.
  forCollectible  Boolean               @default(false)
  // De prompt voor deze ene generatie, door de admin aangepast. Leeg = de prompt uit de instellingen.
  promptOverride  String?
  collectible     Collectible?
  photos          PreviewPhoto[]
  poseCandidates  PoseCandidate[]
  statusChanges   PreviewStatusChange[]
  orderItems      OrderItem[]
  cartLines       CartLine[]

  @@index([status, expiresAt])
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model RateLimit {
  id          String @id
  key         String
  count       Int
  lastRequest BigInt

  @@unique([key])
  @@map("rateLimit")
}

// Foto's van het dier, maximaal MAX_PHOTOS_PER_PREVIEW (src/data/uploads.ts).
model PreviewPhoto {
  id         String   @id @default(uuid())
  previewId  String
  preview    Preview  @relation(fields: [previewId], references: [id], onDelete: Cascade)
  key        String   @unique // R2-key, nooit de foto zelf
  uploadedBy String? // null = klant, anders de naam van de admin
  createdAt  DateTime @default(now())

  @@index([previewId])
}

enum PoseSource {
  GENERATED // door Gemini, telt mee voor MAX_POSE_ATTEMPTS
  UPLOADED // door een admin, elders gemaakt; telt niet mee
}

// Elke pose-afbeelding van een preview: alle pogingen en uploads, zodat een admin ze naast elkaar kan zetten en er één
// kiest. Preview.poseImageKey is de huidige (gekozen) pose en is altijd een van deze keys. Na goedkeuring van het model
// worden de niet-gekozen kandidaten opgeruimd; de retentie ruimt de rest op samen met de foto's.
model PoseCandidate {
  id         String     @id @default(uuid())
  previewId  String
  preview    Preview    @relation(fields: [previewId], references: [id], onDelete: Cascade)
  key        String     @unique // R2-key, onder previews/<id>/
  source     PoseSource
  createdBy  String? // null = de pipeline, anders de naam van de admin
  createdAt  DateTime   @default(now())
  // Deze pose werd goedgekeurd om er een 3D-model van te maken (de laatste keer).
  approvedAt DateTime?
  approvedBy String?

  @@index([previewId, createdAt])
}

// Logboek van handmatige statuswijzigingen door een admin (de noodknop).
model PreviewStatusChange {
  id         String        @id @default(uuid())
  previewId  String
  preview    Preview       @relation(fields: [previewId], references: [id], onDelete: Cascade)
  fromStatus PreviewStatus
  toStatus   PreviewStatus
  reason     String
  changedBy  String
  createdAt  DateTime      @default(now())

  @@index([previewId])
}

// ---------- Shop: cart, orders, payments (eigen checkout, betalen via Stripe Checkout) ----------

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  IN_PRODUCTION
  SHIPPED
  CANCELLED
  EXPIRED
  REFUNDED
}

enum PaymentStatus {
  OPEN
  PENDING
  AUTHORIZED
  PAID
  CANCELED
  EXPIRED
  FAILED
}

// Winkelmandje van een bezoeker. De cookie bevat een willekeurig token, hier staat alleen de hash.
model Cart {
  id        String     @id @default(uuid())
  tokenHash String     @unique
  expiresAt DateTime
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  lines     CartLine[]

  @@index([expiresAt])
}

// Eén lijn per preview (elk huisdier is anders) of per collectible, nooit allebei (check in de migratie).
// Geen prijs: die wordt altijd op de server berekend uit de instellingen of de collectible.
model CartLine {
  id            String       @id @default(uuid())
  cartId        String
  cart          Cart         @relation(fields: [cartId], references: [id], onDelete: Cascade)
  previewId     String?
  preview       Preview?     @relation(fields: [previewId], references: [id], onDelete: Cascade)
  collectibleId String?
  collectible   Collectible? @relation(fields: [collectibleId], references: [id], onDelete: Cascade)
  edition       String? // waarde uit src/data/options.ts (keychain | figure), alleen bij een preview
  attachment    String? // waarde uit src/data/options.ts (clip | key-ring), alleen bij een sleutelhanger
  animal        String? // waarde uit src/data/options.ts (dog, cat, ...), alleen bij een preview
  size          String       @default("M")
  notes         String?
  quantity      Int          @default(1)
  createdAt     DateTime     @default(now())

  @@unique([cartId, previewId])
  // Een collectible kan meermaals in een mandje staan, één lijn per uitvoering (figuurtje, klemmetje, sleutelring).
  @@index([cartId, collectibleId])
  @@index([previewId])
  @@index([collectibleId])
}

// Kant-en-klare modellen die niet gepersonaliseerd zijn. Beheerd in /admin/settings/collectibles.
// Verwijderen = archivedAt zetten: oude orders blijven ernaar verwijzen en herstellen kan altijd.
model Collectible {
  id              String      @id @default(uuid())
  slug            String      @unique // in de URL (/shop/<slug>), verandert niet na het aanmaken
  // Collectible-ID COL-007-HOND (core/utils/naming.ts): het nummer wordt nooit hergebruikt, ook niet na archiveren.
  number          Int         @unique @default(autoincrement())
  animalCode      String? // code uit de dierenlijst, gekozen door de admin
  name            String
  description     String?
  tag             String? // label op de kaart, bv. "Bestseller"
  // Naam, beschrijving en label in de andere talen: { "en": { "name": …, "description": …, "tag": … } }
  translations    Json        @default("{}")
  priceCents      Int // incl. btw
  imageKey        String? // R2-key onder collectibles/, publiek via /api/collectibles/images
  // Het vaste 3D-model: de printklare zip (OBJ + MTL + PNG), zoals die uit Blender. Een bestelling gebruikt altijd dit
  // model (via OrderItem.collectibleId), er wordt nooit een nieuw gegenereerd.
  modelKey        String? // R2-key onder collectibles/models/, privé
  modelFileName   String? // de naam van het geüploade bestand, voor de download
  // De preview waaruit dit model gegenereerd is (een "nieuw collectible-model" op een backoffice-order), als die er is.
  sourcePreviewId String?     @unique
  sourcePreview   Preview?    @relation(fields: [sourcePreviewId], references: [id], onDelete: SetNull)
  published       Boolean     @default(false) // zichtbaar op de website
  soldOut         Boolean     @default(false)
  // Afgewerkte exemplaren op de plank. Null = niet bijgehouden (alles wordt op bestelling geprint). Een betaalde order
  // haalt eraf, een afgeronde voorraadorder (Order.stockOrder) zet erbij.
  stock           Int?
  sortOrder       Int         @default(0)
  archivedAt      DateTime?
  updatedBy       String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  cartLines       CartLine[]
  orderItems      OrderItem[]

  @@index([published, archivedAt, sortOrder])
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

// Kortingscodes, beheerd in /admin/settings/discounts. Korting geldt op de producten, niet op de verzending.
// Het aantal keer gebruikt staat nergens apart: dat zijn de orders die de code dragen en niet geannuleerd of verlopen zijn.
model DiscountCode {
  id               String       @id @default(uuid())
  code             String       @unique // altijd hoofdletters
  type             DiscountType
  value            Int // procent (1-100) of centen, volgens type
  minSubtotalCents Int          @default(0)
  maxRedemptions   Int? // leeg = onbeperkt
  oncePerEmail     Boolean      @default(false)
  personalDelivery Boolean      @default(false) // geeft recht op gratis persoonlijk overhandigen (vrienden en familie)
  startsAt         DateTime?
  expiresAt        DateTime?
  active           Boolean      @default(true)
  note             String? // alleen voor de admin
  updatedBy        String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  orders           Order[]
}

model Order {
  id                      String              @id @default(uuid())
  number                  String              @unique // PLY1042 (core/utils/naming.ts), één doorlopende teller; oude orders PAL-2026-00042
  invoiceNumber           String?             @unique // F2026-0001, toegekend in dezelfde transactie waarin de order betaald wordt
  status                  OrderStatus         @default(PENDING_PAYMENT)
  createdBy               String? // null = via de website, anders de admin die de order toevoegde
  cartId                  String? // het mandje van deze order: na betaling verdwijnen de gekochte collectibles eruit
  discountCodeId          String?
  discount                DiscountCode?       @relation(fields: [discountCodeId], references: [id], onDelete: Restrict)
  discountCode            String? // de code zoals gebruikt, ook als hij later hernoemd wordt
  discountCents           Int                 @default(0) // afgetrokken van het subtotaal, zit al verrekend in totalCents
  email                   String? // alleen leeg bij een handmatige order
  firstName               String
  lastName                String
  phone                   String?
  street                  String? // adres alleen leeg bij een handmatige order die overhandigd wordt
  houseNumber             String?
  postalCode              String?
  city                    String?
  country                 String // ISO-2
  currency                String              @default("EUR")
  subtotalCents           Int
  shippingCents           Int
  vatCents                Int // btw inbegrepen in totalCents
  totalCents              Int
  termsVersion            String? // versie van de voorwaarden die aanvaard werd, leeg bij een handmatige order
  termsAcceptedAt         DateTime?
  locale                  String              @default("nl")
  marketingOptIn          Boolean             @default(false)
  // Apart en vrijwillig, alleen bij een Palley op maat: we mogen de foto en de Palley gebruiken voor marketing (art. 5.4).
  // Zolang dit aan staat, verwijdert de cron de foto's niet. Intrekken = een admin zet het uit.
  photoMarketingConsent   Boolean             @default(false)
  photoMarketingConsentAt DateTime?
  statusTokenHash         String // sha256 van het token in de return-URL; het token zelf bewaren we niet
  attentionReason         String? // iets klopte niet (bedrag, preview al betaald, ...): opvolgen in de backoffice
  // Een voorraadorder: collectibles die we op voorhand laten maken, zonder klant en zonder betaling. Afgerond
  // (SHIPPED) = de exemplaren liggen klaar en tellen bij Collectible.stock.
  stockOrder              Boolean             @default(false)
  // Vrij notitieblok van het team (bv. de Instagram-naam van wie komt ophalen). Nooit zichtbaar voor de klant.
  adminNotes              String?
  adminNotesUpdatedAt     DateTime?
  adminNotesUpdatedBy     String?
  confirmationSentAt      DateTime?
  // De eerste pose van een Palley op maat is goedgekeurd: de order is in productie (en de klant kreeg een mail).
  // Vanaf dan kan een Palley op maat niet meer kosteloos geannuleerd worden.
  productionStartedAt     DateTime?
  paidAt                  DateTime?
  // De printbatch voor JLC. Een order zit in hoogstens één batch, altijd volledig.
  batchId                 String?
  batch                   Batch?              @relation(fields: [batchId], references: [id], onDelete: Restrict)
  // Een herprint na een garantieclaim is een eigen order van € 0. De Palley-namen blijven die van de oorspronkelijke order.
  reprintOfId             String?
  reprintOf               Order?              @relation("Reprints", fields: [reprintOfId], references: [id], onDelete: SetNull)
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  items                   OrderItem[]
  payments                Payment[]
  shipment                Shipment?
  statusChanges           OrderStatusChange[]
  reprints                Order[]             @relation("Reprints")
  returnRequests          ReturnRequest[]
  reprintFor              ReturnRequest?      @relation("ReprintOrder")
  returnAccess            ReturnAccess[]

  @@index([status, createdAt])
  @@index([paidAt])
  @@index([email])
  @@index([discountCodeId])
  @@index([batchId])
  @@index([reprintOfId])
}

model OrderItem {
  id                String              @id @default(uuid())
  orderId           String
  order             Order               @relation(fields: [orderId], references: [id], onDelete: Restrict)
  previewId         String? // gepersonaliseerd: gaat door de AI-pipeline
  preview           Preview?            @relation(fields: [previewId], references: [id], onDelete: Restrict)
  collectibleId     String? // kant-en-klaar: slaat de pipeline over
  collectible       Collectible?        @relation(fields: [collectibleId], references: [id], onDelete: Restrict)
  position          Int // volgorde in de order, vanaf 1: het {nn} in de naam van de Palley
  productCode       String // P-RING-KAT of COL-CLP-007, zoals bij het bestellen (core/utils/naming.ts)
  size              String
  edition           String?
  attachment        String? // clip | key-ring, alleen bij een sleutelhanger
  animal            String?
  title             String // zoals de klant het zag, bv. "Palley Hond · Met sleutelhanger"
  notes             String?
  quantity          Int                 @default(1)
  unitCents         Int
  withdrawable      Boolean             @default(false) // gepersonaliseerd = uitzondering op het herroepingsrecht (art. VI.53, 3° WER)
  checkedInAt       DateTime? // een admin heeft dit item gecontroleerd en klaargelegd
  checkedInBy       String?
  reprintNr         Int                 @default(0) // > 0 = opnieuw geprint: de naam krijgt -R<n>
  // Geannuleerd of herroepen vóór verzending (goedgekeurde aanvraag): die exemplaren worden niet gemaakt.
  // Op quantity = alles geannuleerd: het item telt niet meer mee voor check-in en batches.
  cancelledQuantity Int                 @default(0)
  returnItems       ReturnRequestItem[]

  @@unique([orderId, position])
  @@index([previewId])
  @@index([collectibleId])
}

model Payment {
  id                String        @id @default(uuid())
  orderId           String
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  provider          String        @default("stripe") // oudere rijen: "bancontact"; met de hand: "manual"
  providerPaymentId String        @unique // Stripe Checkout Session-id (cs_test_… / cs_live_…)
  mode              String? // test | live
  method            String? // bancontact | ideal | wero | … (wat de klant echt gebruikte), of cash, transfer, …
  status            PaymentStatus @default(OPEN)
  amountCents       Int
  refundedCents     Int           @default(0)
  chargedBackCents  Int           @default(0)
  checkoutUrl       String?
  adjustments       PaymentAdjustment[]
  rawLastStatus     Json? // veilige selectie uit de laatste Checkout Session (zonder naam, e-mail of rekening van de betaler)
  lastSyncedAt      DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([orderId])
}

enum PaymentAdjustmentKind {
  REFUND
  CHARGEBACK
}

// Wanneer geld terugging (of terugkwam): elke wijziging van Payment.refundedCents of chargedBackCents, met de datum waarop
// wij ze zagen. Het verkoopdagboek boekt terugbetalingen hiermee op hun eigen dag. Alleen toevoegen, nooit aanpassen.
model PaymentAdjustment {
  id          String                @id @default(uuid())
  paymentId   String
  payment     Payment               @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  kind        PaymentAdjustmentKind
  amountCents Int // het verschil: positief = geld terug naar de klant, negatief = teruggedraaid (bv. dispute gewonnen)
  occurredAt  DateTime              @default(now())
  source      String // webhook | return-page | admin:<naam> | backfill | ...

  @@index([occurredAt])
  @@index([paymentId])
}

model Shipment {
  id                 String    @id @default(uuid())
  orderId            String    @unique
  order              Order     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  provider           String // static
  deliveryOptionId   String
  deliveryType       String // HOME | SERVICE_POINT
  carrier            String // bpost, postnl, ...
  label              String // zoals de klant de optie zag
  priceCents         Int
  trackingCode       String? // handmatig ingevuld bij verzenden (bpost)
  trackingUrl        String?
  shippedAt          DateTime? // verzonden, opgehaald of overhandigd
  // Ontvangen door de klant: start van de herroepingstermijn. Leeg = geschat (core/modules/returns/utils.ts), tenzij het
  // team de echte datum invult.
  deliveredAt        DateTime?
  readyForPickupAt   DateTime? // afhalen: klaargelegd en de klant gemaild (één keer)
  readyForPickupBy   String?
  lastPickupUpdateAt DateTime? // laatste update-mail over wanneer afhalen kan
}

enum BatchStatus {
  OPEN
  SENT_TO_JLC
  IN_POST_PRODUCTION
  COMPLETED
}

// Printbatch voor JLC: betaalde, printklare orders samen. Overgangen in core/modules/batches/status.ts.
model Batch {
  id            String              @id @default(uuid())
  number        Int                 @unique // BATCH-0001 (core/utils/naming.ts), uit de teller "batch"
  status        BatchStatus         @default(OPEN)
  createdAt     DateTime            @default(now())
  createdBy     String
  sentToJlcAt   DateTime?
  sentToJlcBy   String?
  receivedAt    DateTime?
  receivedBy    String?
  completedAt   DateTime?
  note          String?
  orders        Order[]
  statusChanges BatchStatusChange[]

  @@index([status, createdAt])
}

// Logboek van elke statuswijziging van een batch: wie en wanneer.
model BatchStatusChange {
  id         String       @id @default(uuid())
  batchId    String
  batch      Batch        @relation(fields: [batchId], references: [id], onDelete: Cascade)
  fromStatus BatchStatus?
  toStatus   BatchStatus
  source     String // admin:<naam> | system
  note       String?
  createdAt  DateTime     @default(now())

  @@index([batchId])
}

// Tellers zonder gaten: de waarde stijgt in dezelfde transactie als wat ze nummert.
// Sleutels: "order" (doorlopend) en "invoice-<jaar>".
model Counter {
  key  String @id
  last Int    @default(0)
}

// Logboek van elke statuswijziging van een order: wie of wat (webhook, cron, admin) en wanneer.
model OrderStatusChange {
  id         String       @id @default(uuid())
  orderId    String
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus OrderStatus?
  toStatus   OrderStatus
  source     String // webhook | return-page | cron | admin:<naam> | checkout | customer (via /retour)
  note       String?
  createdAt  DateTime     @default(now())

  @@index([orderId])
}

// Wat een admin in de backoffice wijzigde buiten de orders om (bv. een betaalmethode aan of uit in Stripe): wie, wat,
// oud → nieuw. Alleen toevoegen, nooit aanpassen. Geen klantgegevens.
model AdminAuditLog {
  id        String   @id @default(uuid())
  actor     String // naam van de admin
  action    String // bv. payment_method.toggle
  subject   String // bv. ideal
  fromValue String?
  toValue   String?
  createdAt DateTime @default(now())

  @@index([action, createdAt])
}

// Winkelinstellingen die een admin in /admin/settings aanpast. Altijd één rij (id = 1).
model ShopSettings {
  id                    Int      @id @default(1)
  checkoutEnabled       Boolean  @default(true)
  checkoutClosedMessage String?
  shippingOverrides     Json? // { [deliveryOptionId]: { priceCents, enabled } }
  // Secties uit core/modules/settings/types.ts. Leeg of ongeldig = de startwaarden uit src/data.
  catalog               Json? // prijzen en beschikbare opties van de gepersonaliseerde Palley
  siteContent           Json? // teksten op de website
  company               Json? // bedrijfsgegevens en sociale media
  prompts               Json? // de Nano Banana-prompt: algemeen en per diersoort
  updatedBy             String?
  updatedAt             DateTime @updatedAt
}

// Mailinglijst: wie in de checkout aanvinkte op de hoogte te blijven van nieuwe Palleys. Los van de order, want de
// retentie ruimt orders op en dit blijft tot iemand zich uitschrijft. We versturen nog niets.
model NewsletterSubscriber {
  id             String    @id @default(uuid())
  email          String    @unique // altijd kleine letters
  locale         String    @default("nl")
  source         String // checkout
  subscribedAt   DateTime  @default(now()) // laatste keer dat er toestemming gegeven werd
  unsubscribedAt DateTime? // gezet = uitgeschreven, niet mailen
}

// Rate limiting per IP (gehasht) en route, vast venster.
model RequestLimit {
  key         String   @id
  count       Int
  windowStart DateTime
}

// Wat er van een verwijderde order bewaard blijft (bv. een testorder): wie, wanneer en waarom, zonder klantgegevens.
// Een ordernummer of factuurnummer wordt nooit opnieuw uitgedeeld; hier staat waarom het ontbreekt.
model DeletedOrder {
  id             String   @id @default(uuid())
  orderId        String // de id van de verwijderde order
  number         String
  invoiceNumber  String?
  status         String // de status op het moment van verwijderen
  totalCents     Int
  paymentSummary String // bv. "stripe live PAID 100" per betaling, of "geen"
  orderCreatedAt DateTime
  reason         String
  deletedBy      String
  deletedAt      DateTime @default(now())

  @@index([number])
}

// ---------- Retour: annuleren, herroepen, garantie (/retour) ----------

enum ReturnType {
  CANCELLATION // Palley op maat, nog niet in productie
  WITHDRAWAL // herroeping van een Palley uit de collectie
  WARRANTY // beschadigd, defect of niet wat besteld werd
}

enum ReturnResolution {
  REPRINT
  REFUND
}

enum ReturnStatus {
  SUBMITTED
  APPROVED
  REJECTED
  COMPLETED
}

// Een aanvraag van de klant via /retour. Overgangen in core/modules/returns/status.ts; elke stap komt ook in de
// statuslog van de order. Terugbetalen gebeurt met de hand in het Stripe-dashboard.
model ReturnRequest {
  id             String              @id @default(uuid())
  orderId        String
  order          Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type           ReturnType
  resolution     ReturnResolution? // wat de klant kiest bij een garantieclaim
  reason         String? // de reden (optioneel) of de beschrijving van het probleem
  photoKeys      String[] // R2-keys onder returns/<orderId>/, privé
  // Herroeping: had de klant de Palleys al (dan stuurt hij ze terug) of nog niet (meteen terugbetalen).
  itemsReceived  Boolean             @default(false)
  status         ReturnStatus        @default(SUBMITTED)
  decisionNote   String? // bij afwijzen: de reden, die naar de klant gaat
  locale         String              @default("nl")
  submittedAt    DateTime            @default(now())
  decidedAt      DateTime?
  decidedBy      String?
  completedAt    DateTime?
  completedBy    String?
  // De herprint-order die bij het goedkeuren gemaakt werd.
  reprintOrderId String?             @unique
  reprintOrder   Order?              @relation("ReprintOrder", fields: [reprintOrderId], references: [id], onDelete: SetNull)
  items          ReturnRequestItem[]

  @@index([status, submittedAt])
  @@index([orderId])
}

model ReturnRequestItem {
  id              String        @id @default(uuid())
  returnRequestId String
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  orderItemId     String
  orderItem       OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  quantity        Int

  @@unique([returnRequestId, orderItemId])
  @@index([orderItemId])
}

// De eenmalige link uit de mail van /retour, en de sessie die ze opent. Alleen hashes, nooit de tokens.
model ReturnAccess {
  id               String    @id @default(uuid())
  orderId          String
  order            Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  linkTokenHash    String    @unique
  linkExpiresAt    DateTime
  usedAt           DateTime? // de link is geopend: hij werkt geen tweede keer
  sessionTokenHash String?   @unique
  sessionExpiresAt DateTime?
  createdAt        DateTime  @default(now())

  @@index([orderId])
  @@index([linkExpiresAt])
}

// Juridische documenten die een admin in /admin/settings/legal publiceert (core/modules/legal). Elke publicatie is een
// nieuwe rij die nooit meer wijzigt: Order.termsVersion en de link in de bevestigingsmail wijzen naar een versie.
// Geen rij = de teksten uit src/core/locale/messages (versie LEGAL_FALLBACK_VERSION).
enum LegalDocumentKind {
  PRIVACY
  TERMS
  RETURNS
  SHIPPING
  CONTACT
}

model LegalDocumentVersion {
  id            String            @id @default(uuid())
  document      LegalDocumentKind
  version       String // 2026-11-11, een tweede publicatie op dezelfde dag 2026-11-11-2
  effectiveDate DateTime          @db.Date // "laatst bijgewerkt op"
  content       Json // per taal { title, intro, sections } of { title, intro, rows, seeAlso }
  publishedBy   String // naam van de admin
  createdAt     DateTime          @default(now())

  @@unique([document, version])
  @@index([document, createdAt])
}
