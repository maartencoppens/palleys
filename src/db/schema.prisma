// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

enum PreviewStatus {
  UPLOADED
  PAID
  GENERATING_POSE
  POSE_READY
  GENERATING_MODEL
  MODEL_READY
  APPROVED
  PRINT_READY
  FAILED
  EXPIRED
}

model Preview {
  id                String                @id @default(uuid())
  status            PreviewStatus         @default(UPLOADED)
  poseImageKey      String?
  glbKey            String? // voor de 3D-viewer in de backoffice
  objKey            String? // printbestanden voor full color resin:
  mtlKey            String? //   OBJ + MTL + PNG-textuur, altijd samen
  textureKey        String?
  meshyTaskId       String?               @unique
  email             String?
  poseAttempts      Int                   @default(0)
  error             String?
  shopifyOrderId    String?
  // Ordernummer in de printbestandsnaam: PAL-2026-00042, of het Shopify-nummer (bv. "1042") voor oude orders.
  orderNumber       String?               @map("shopifyOrderNumber")
  paidAt            DateTime? // orderdatum, gezet bij betaling (Bancontact-callback of statuscheck)
  animalType        String? // code uit src/data/animals.ts, gekozen door de admin
  shopifyLineItemId String?               @unique
  quantity          Int                   @default(1) // aantal exemplaren van deze Palley in de order, gezet bij betaling
  createdAt         DateTime              @default(now())
  expiresAt         DateTime? // alleen voor niet-betaalde uploads, leeg na betaling
  photosDeleteAt    DateTime? // voor betaalde orders, na verzending
  downloadedAt      DateTime?
  downloadedBy      String?
  processedKey      String? // zip uit Blender, klaar voor print
  processedAt       DateTime?
  processedBy       String?
  // Gemaakt om een collectible van te maken (backoffice-order), niet voor een klant.
  forCollectible    Boolean               @default(false)
  // De prompt voor deze ene generatie, door de admin aangepast. Leeg = de prompt uit de instellingen.
  promptOverride    String?
  collectible       Collectible?
  photos            PreviewPhoto[]
  statusChanges     PreviewStatusChange[]
  orderItems        OrderItem[]
  cartLines         CartLine[]

  @@index([status, expiresAt])
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model RateLimit {
  id          String @id
  key         String
  count       Int
  lastRequest BigInt

  @@unique([key])
  @@map("rateLimit")
}

// Foto's van het dier, maximaal MAX_PHOTOS_PER_PREVIEW (src/data/uploads.ts).
model PreviewPhoto {
  id         String   @id @default(uuid())
  previewId  String
  preview    Preview  @relation(fields: [previewId], references: [id], onDelete: Cascade)
  key        String   @unique // R2-key, nooit de foto zelf
  uploadedBy String? // null = klant, anders de naam van de admin
  createdAt  DateTime @default(now())

  @@index([previewId])
}

// Logboek van handmatige statuswijzigingen door een admin (de noodknop).
model PreviewStatusChange {
  id         String        @id @default(uuid())
  previewId  String
  preview    Preview       @relation(fields: [previewId], references: [id], onDelete: Cascade)
  fromStatus PreviewStatus
  toStatus   PreviewStatus
  reason     String
  changedBy  String
  createdAt  DateTime      @default(now())

  @@index([previewId])
}

// ---------- Shop: cart, orders, payments (eigen checkout met Bancontact Pro) ----------

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  IN_PRODUCTION
  SHIPPED
  CANCELLED
  EXPIRED
  REFUNDED
}

enum PaymentStatus {
  OPEN
  PENDING
  AUTHORIZED
  PAID
  CANCELED
  EXPIRED
  FAILED
}

// Winkelmandje van een bezoeker. De cookie bevat een willekeurig token, hier staat alleen de hash.
model Cart {
  id        String     @id @default(uuid())
  tokenHash String     @unique
  expiresAt DateTime
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  lines     CartLine[]

  @@index([expiresAt])
}

// Eén lijn per preview (elk huisdier is anders) of per collectible, nooit allebei (check in de migratie).
// Geen prijs: die wordt altijd op de server berekend uit de instellingen of de collectible.
model CartLine {
  id            String       @id @default(uuid())
  cartId        String
  cart          Cart         @relation(fields: [cartId], references: [id], onDelete: Cascade)
  previewId     String?
  preview       Preview?     @relation(fields: [previewId], references: [id], onDelete: Cascade)
  collectibleId String?
  collectible   Collectible? @relation(fields: [collectibleId], references: [id], onDelete: Cascade)
  edition       String? // waarde uit src/data/options.ts (keychain | figure), alleen bij een preview
  attachment    String? // waarde uit src/data/options.ts (clip | key-ring), alleen bij een sleutelhanger
  animal        String? // waarde uit src/data/options.ts (dog, cat, ...), alleen bij een preview
  size          String       @default("M")
  notes         String?
  quantity      Int          @default(1)
  createdAt     DateTime     @default(now())

  @@unique([cartId, previewId])
  @@unique([cartId, collectibleId])
  @@index([previewId])
  @@index([collectibleId])
}

// Kant-en-klare modellen die niet gepersonaliseerd zijn. Beheerd in /admin/settings/collectibles.
// Verwijderen = archivedAt zetten: oude orders blijven ernaar verwijzen en herstellen kan altijd.
model Collectible {
  id              String      @id @default(uuid())
  slug            String      @unique // in de URL (/shop/<slug>), verandert niet na het aanmaken
  sku             String      @unique // PAL-COL-<SLUG>
  name            String
  description     String?
  tag             String? // label op de kaart, bv. "Bestseller"
  // Naam, beschrijving en label in de andere talen: { "en": { "name": …, "description": …, "tag": … } }
  translations    Json        @default("{}")
  priceCents      Int // incl. btw
  imageKey        String? // R2-key onder collectibles/, publiek via /api/collectibles/images
  // Het vaste 3D-model: de printklare zip (OBJ + MTL + PNG), zoals die uit Blender. Een bestelling gebruikt altijd dit
  // model (via OrderItem.collectibleId), er wordt nooit een nieuw gegenereerd.
  modelKey        String? // R2-key onder collectibles/models/, privé
  modelFileName   String? // de naam van het geüploade bestand, voor de download
  // De preview waaruit dit model gegenereerd is (een "nieuw collectible-model" op een backoffice-order), als die er is.
  sourcePreviewId String?     @unique
  sourcePreview   Preview?    @relation(fields: [sourcePreviewId], references: [id], onDelete: SetNull)
  published       Boolean     @default(false) // zichtbaar op de website
  soldOut         Boolean     @default(false)
  sortOrder       Int         @default(0)
  archivedAt      DateTime?
  updatedBy       String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  cartLines       CartLine[]
  orderItems      OrderItem[]

  @@index([published, archivedAt, sortOrder])
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

// Kortingscodes, beheerd in /admin/settings/discounts. Korting geldt op de producten, niet op de verzending.
// Het aantal keer gebruikt staat nergens apart: dat zijn de orders die de code dragen en niet geannuleerd of verlopen zijn.
model DiscountCode {
  id               String       @id @default(uuid())
  code             String       @unique // altijd hoofdletters
  type             DiscountType
  value            Int // procent (1-100) of centen, volgens type
  minSubtotalCents Int          @default(0)
  maxRedemptions   Int? // leeg = onbeperkt
  oncePerEmail     Boolean      @default(false)
  personalDelivery Boolean      @default(false) // geeft recht op gratis persoonlijk overhandigen (vrienden en familie)
  startsAt         DateTime?
  expiresAt        DateTime?
  active           Boolean      @default(true)
  note             String? // alleen voor de admin
  updatedBy        String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  orders           Order[]
}

model Order {
  id                 String              @id @default(uuid())
  number             String              @unique // PAL-2026-00042, sequentieel per jaar
  status             OrderStatus         @default(PENDING_PAYMENT)
  createdBy          String? // null = via de website, anders de admin die de order toevoegde
  cartId             String? // het mandje van deze order: na betaling verdwijnen de gekochte collectibles eruit
  discountCodeId     String?
  discount           DiscountCode?       @relation(fields: [discountCodeId], references: [id], onDelete: Restrict)
  discountCode       String? // de code zoals gebruikt, ook als hij later hernoemd wordt
  discountCents      Int                 @default(0) // afgetrokken van het subtotaal, zit al verrekend in totalCents
  email              String? // alleen leeg bij een handmatige order
  firstName          String
  lastName           String
  phone              String?
  street             String? // adres alleen leeg bij een handmatige order die overhandigd wordt
  houseNumber        String?
  postalCode         String?
  city               String?
  country            String // ISO-2
  currency           String              @default("EUR")
  subtotalCents      Int
  shippingCents      Int
  vatCents           Int // btw inbegrepen in totalCents
  totalCents         Int
  termsVersion       String? // versie van de voorwaarden die aanvaard werd, leeg bij een handmatige order
  termsAcceptedAt    DateTime?
  locale             String              @default("nl")
  marketingOptIn     Boolean             @default(false)
  statusTokenHash    String // sha256 van het token in de return-URL; het token zelf bewaren we niet
  attentionReason    String? // iets klopte niet (bedrag, preview al betaald, ...): opvolgen in de backoffice
  confirmationSentAt DateTime?
  paidAt             DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  items              OrderItem[]
  payments           Payment[]
  shipment           Shipment?
  statusChanges      OrderStatusChange[]

  @@index([status, createdAt])
  @@index([email])
  @@index([discountCodeId])
}

model OrderItem {
  id            String       @id @default(uuid())
  orderId       String
  order         Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  previewId     String? // gepersonaliseerd: gaat door de AI-pipeline
  preview       Preview?     @relation(fields: [previewId], references: [id], onDelete: Restrict)
  collectibleId String? // kant-en-klaar: slaat de pipeline over
  collectible   Collectible? @relation(fields: [collectibleId], references: [id], onDelete: Restrict)
  sku           String
  size          String
  edition       String?
  attachment    String? // clip | key-ring, alleen bij een sleutelhanger
  animal        String?
  title         String // zoals de klant het zag, bv. "Palley Hond · Met sleutelhanger"
  notes         String?
  quantity      Int          @default(1)
  unitCents     Int
  withdrawable  Boolean      @default(false) // gepersonaliseerd = uitzondering op het herroepingsrecht (art. VI.53, 3° WER)
  checkedInAt   DateTime? // een admin heeft dit item gecontroleerd en klaargelegd
  checkedInBy   String?

  @@index([orderId])
  @@index([previewId])
  @@index([collectibleId])
}

model Payment {
  id                String        @id @default(uuid())
  orderId           String
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  provider          String        @default("bancontact")
  providerPaymentId String        @unique // Bancontact paymentId (24 tekens)
  mode              String? // test (preprod) | live (production)
  method            String? // bancontact
  status            PaymentStatus @default(OPEN)
  amountCents       Int
  refundedCents     Int           @default(0)
  chargedBackCents  Int           @default(0)
  checkoutUrl       String?
  rawLastStatus     Json? // veilige selectie uit het laatste payment-object (zonder naam/IBAN van de betaler)
  lastSyncedAt      DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([orderId])
}

model Shipment {
  id                   String    @id @default(uuid())
  orderId              String    @unique
  order                Order     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  provider             String // static | sendcloud
  deliveryOptionId     String
  deliveryType         String // HOME | SERVICE_POINT
  carrier              String // bpost, postnl, ...
  label                String // zoals de klant de optie zag
  priceCents           Int
  checkoutIdentifier   String? // Sendcloud Dynamic Checkout, nodig om later de zending aan te maken
  servicePointId       String?
  servicePointSnapshot Json?
  providerShipmentId   String?
  trackingCode         String?
  trackingUrl          String?
  labelKey             String? // R2-key van het label (signed URL in de admin)
  providerStatus       String? // laatste status van de vervoerder via Sendcloud, bv. "Delivered"
  providerStatusAt     DateTime? // wanneer die status inging: oudere webhooks (ze komen niet altijd op volgorde) worden genegeerd
  shippedAt            DateTime?
}

// Ordernummers zonder gaten: de teller stijgt in dezelfde transactie als de order.
model OrderCounter {
  year Int @id
  last Int @default(0)
}

// Logboek van elke statuswijziging van een order: wie of wat (webhook, cron, admin) en wanneer.
model OrderStatusChange {
  id         String       @id @default(uuid())
  orderId    String
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus OrderStatus?
  toStatus   OrderStatus
  source     String // webhook | return-page | cron | admin:<naam> | checkout
  note       String?
  createdAt  DateTime     @default(now())

  @@index([orderId])
}

// Winkelinstellingen die een admin in /admin/settings aanpast. Altijd één rij (id = 1).
model ShopSettings {
  id                    Int      @id @default(1)
  checkoutEnabled       Boolean  @default(true)
  checkoutClosedMessage String?
  shippingOverrides     Json? // { [deliveryOptionId]: { priceCents, enabled } }
  // Secties uit core/modules/settings/types.ts. Leeg of ongeldig = de startwaarden uit src/data.
  catalog               Json? // prijzen en beschikbare opties van de gepersonaliseerde Palley
  siteContent           Json? // teksten op de website
  company               Json? // bedrijfsgegevens en sociale media
  prompts               Json? // de Nano Banana-prompt: algemeen en per diersoort
  updatedBy             String?
  updatedAt             DateTime @updatedAt
}

// Rate limiting per IP (gehasht) en route, vast venster.
model RequestLimit {
  key         String   @id
  count       Int
  windowStart DateTime
}
